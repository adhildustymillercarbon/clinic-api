# API Security
API_KEY=secret-api-key

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://clinic:clinic_secret@localhost:5432/clinic_booking

# Redis Store (Idempotency & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting Configuration
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# Idempotency TTL (seconds)
IDEMPOTENCY_TTL_SECONDS=86400

# OpenObserve Observability (Traces & Logs)
OPENOBSERVE_AI_TOKEN=
OPENOBSERVE_ENDPOINT=https://api.openobserve.ai
OPENOBSERVE_ORG=default
OPENOBSERVE_STREAM=default
OPENOBSERVE_SERVICE_NAME=clinic-booking
OPENOBSERVE_ENABLED=true

# Error Log Trace Webhook (Bearer Token Auth)
ERROR_WEBHOOK_URL=
ERROR_WEBHOOK_TOKEN=
ERROR_WEBHOOK_ENABLED=true
ERROR_WEBHOOK_THROTTLE_SECONDS=60
ERROR_WEBHOOK_TIMEOUT=5.0
